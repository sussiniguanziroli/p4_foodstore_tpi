# Copiar este archivo como .env y completar los valores (el .env NO se sube al repositorio).

# Conexión a PostgreSQL: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
# (para desarrollo rápido sin PostgreSQL también sirve: sqlite:///./foodstore.db)
DATABASE_URL=postgresql://postgres:CAMBIAR_CLAVE@localhost:5432/foodstore_db

# Clave con la que se firman los JWT: mínimo 32 caracteres. Para generar una:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

# Algoritmo de firma del JWT
ALGORITHM=HS256

# Duración del token y de la cookie, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend autorizado por CORS (varios: separados por coma)
FRONTEND_ORIGIN=http://localhost:5173

# true solo en producción con HTTPS (la cookie viaja únicamente cifrada)
COOKIE_SECURE=false
